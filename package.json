{
    "name": "local-mcp",
    "version": "2.0.0",
    "description": "Remote MCP server that gives Claude access to a local machine, protected by OAuth.",
    "private": true,
    "author": "lucaaszsx",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "oauth",
        "claude"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucaaszsx/MyDeskMCP.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/MyDeskMCP/issues"
    },
    "homepage": "https://github.com/lucaaszsx/MyDeskMCP#readme",
    "type": "module",
    "main": "dist/main.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "format": "prettier --write src"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "express": "^5.3.0",
        "zod": "^4.6.7"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.14.0",
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
